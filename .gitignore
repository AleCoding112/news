.DS_Store
node_modules/

# Derivati di un ciclo: si rigenerano, non si versionano.
candidati.json

# Le istantanee intere pesano mezzo megabyte l'una e restano locali.
# Nel repo va solo la finestra compatta delle notizie, che scrive
# l'azione su GitHub. Lo schema `grezzo/*.json` copriva solo il primo
# livello e si lasciava sfuggire grezzo/calcio/: ci vogliono entrambe
# le righe.
grezzo/*.json
grezzo/**/*.json
!grezzo/finestra.json

# Tracce di esecuzione del ciclo: utili la mattina dopo, inutili nella
# storia. I file portano il nome della testata, quindi si ignorano per
# modello. `.state/coperti*.json` invece resta versionato: è memoria,
# non traccia.
.state/ciclo*.log
.state/launchd*.log
.state/in-corso*
.state/ultimo-redattore*
.state/ultima-validazione*
.state/prompt-usato*

# I candidati sono derivati di un ciclo, per entrambe le testate.
candidati-calcio.json
